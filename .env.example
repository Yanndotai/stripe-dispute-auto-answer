# Copy to .env (local) or set these in your host's env / secret store.
# NEVER commit real values — .env is gitignored.

# --- Stripe (required) ---
STRIPE_KEY=                 # restricted key: dispute_write + read charges/customers/subscriptions/invoices/files
STRIPE_WEBHOOK_SECRET=      # signing secret of your Stripe webhook endpoint (whsec_...)

# --- LLM provider (required) — any OpenAI-compatible Chat Completions endpoint ---
LLM_API_KEY=               # your provider API key
LLM_BASE_URL=              # leave empty for OpenAI; otherwise the provider base URL (see README)
LLM_MODEL=                 # e.g. gpt-4o  |  grok-2-latest  |  your Claude model id  |  a local model

# --- Merchant identity (recommended — shown to the model + on evidence) ---
MERCHANT_NAME=             # your business name
MERCHANT_DESCRIPTION=      # one line: what you sell
MERCHANT_POLICY_SUMMARY=   # one paragraph summarizing your refund/cancellation terms
SUPPORT_EMAIL=             # public support mailbox printed on evidence (e.g. support@yourcompany.com)
POLICY_PDF_PATH=           # path to your refund/cancellation policy PDF (default: assets/policy.pdf)

# --- Optional enrichment (defaults — skip or swap, see README) ---
# Product usage. Default adapter = PostHog. Leave blank to skip, or replace
# _gather_posthog in dispute_brain.py to use Amplitude / Mixpanel / your DB.
POSTHOG_KEY=
POSTHOG_PROJECT_ID=        # required if POSTHOG_KEY is set
# Comma-separated event names from YOUR product that prove the customer used it.
# Example: signup,project_created,export_completed
# Without this list, PostHog still contributes geo/device, but no usage counts.
POSTHOG_USAGE_EVENTS=
# Support-contact proof. Default adapter = Help Scout. Leave blank to skip, or
# replace _gather_helpscout / _helpscout_pdf to use Zendesk / Intercom / etc.
HELPSCOUT_CLIENT_ID=
HELPSCOUT_CLIENT_SECRET=

# --- Optional notification ---
NOTIFY_WEBHOOK_URL=        # Slack incoming webhook (auto-formatted) or any URL (gets JSON)
